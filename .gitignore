# ChromaDB persistent storage (root-level only — do NOT use a bare "data/"
# pattern here, it would also match src/rag_mcp/data/, which holds real
# packaging content copied by scripts/sync_package_data.py and must be
# committed so wheels built from a fresh clone aren't missing config templates)
/data/

# Local PyPI index package storage (setup-pypi.bat output; rebuilt from dist/)
/packages/

# Machine-specific config (generated from template by setup.bat / setup-docker.*)
config/config.yaml
config/config.docker.yaml
config.yaml
reindex_log*

# Runtime-generated files
indexer.log

# Machine-specific MCP config (generated by setup.bat)
.kiro/settings/mcp.json

# Machine-specific hooks (generated by setup.bat)
.kiro/hooks/

#Grafiphy
graphify*/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
.pytest*/*

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/*
!.vscode/mcp.json
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# specs
.kiro/

# pytest
.pytest_cache/
projects/